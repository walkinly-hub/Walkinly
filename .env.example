# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration. Never prefix this key with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Meta WhatsApp Cloud API configuration.
# Use the Graph API version and phone number ID shown in Meta's API Setup.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Server-only webhook secrets; app secret from Meta app settings (not access token).
WHATSAPP_APP_SECRET=
# Random secret chosen by you; enter the same value in Meta's webhook verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Separate secret authenticating Supabase Database Webhooks (not Meta webhooks).
WHATSAPP_DISPATCH_SECRET=
# Enable only after the reminder migration and database webhook are configured.
WHATSAPP_AUTOMATION_ENABLED=false
