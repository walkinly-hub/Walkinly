# Public Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration. Never prefix this key with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Meta WhatsApp Cloud API configuration.
# Use the Graph API version and phone number ID shown in Meta's API Setup.
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
